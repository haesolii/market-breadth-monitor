# Copy to .env (never commit .env).

# Optional. Massive (formerly Polygon.io) API key -> enables the survivorship-free
# self-computed scanner (source "massive"). Free "Basic" plan works but is slow (5 req/min).
MASSIVE_API_KEY=
# Requests per minute allowed by your Massive plan (free plan = 5).
MASSIVE_RATE_PER_MIN=5
# How far back to backfill Massive grouped-daily bars (free plan serves ~2 years).
MASSIVE_START=2024-11-01

# Enable the free Yahoo-based scanner (per-ticker results, survivorship-biased). 1=on, 0=off
YAHOO_SCANNER=1

# Auto-refresh check interval while the server runs (minutes).
REFRESH_INTERVAL_MIN=15

# Where Parquet files are stored (default: ./data)
# DATA_DIR=

# KOSPI / KOSDAQ market monitor (KRX KIND listing + Yahoo prices). 1=on, 0=off
KR_SCANNER=1

# Crypto market monitor (Binance spot USDT pairs incl. delisted, public data). 1=on, 0=off
CRYPTO_SCANNER=1

# Optional. AI market brief (python -m app.brief) with Claude. Without it the brief step is skipped.
# ANTHROPIC_API_KEY=

# Optional. Korean preliminary earnings (잠정실적) from DART; free key at https://opendart.fss.or.kr
# DART_API_KEY=

# Optional. US CPI / jobs / PPI / retail sales / JOLTS release dates (FRED release calendar); free key at https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=
